{
  "name": "technovation-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0 --port 8443",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview --port 8443",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "format": "oxfmt",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "db:seed:catalog": "node prisma/seed-catalog.mjs",
    "db:setup": "prisma generate && prisma db push && node prisma/seed.mjs"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "nuxt": "^4.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.3.1",
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vue-tsc": "^3.0.0",
    "prisma": "^6.0.0"
  }
}
