# Production: use an absolute path on persistent, writable storage.
# Example: DATABASE_URL="file:/var/lib/technovation/technovation.db"
DATABASE_URL="file:./dev.db"

# Used only by npm run db:seed to create/update the first admin.
ADMIN_NAME="Technovation Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-unique-password"
