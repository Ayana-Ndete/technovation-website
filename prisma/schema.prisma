generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  tokenHash String   @id
  adminId   Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  summary     String
  topic       String
  kind        String
  author      String
  body        String
  status      String    @default("DRAFT")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
}

model Project {
  id             String   @id @default(cuid())
  name           String
  description    String
  category       String
  place          String
  image          String   @default("")
  imageAlt       String   @default("")
  features       Json     @default("[]")
  status         String   @default("DRAFT")
  sortOrder      Int      @default(0)
  showInExplorer Boolean  @default(true)
  featured       Boolean  @default(false)
  client         String   @default("")
  imageCreditUrl String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, sortOrder])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  image       String   @default("")
  imageAlt    String   @default("")
  features    Json     @default("[]")
  enquiryUrl  String   @default("")
  status      String   @default("DRAFT")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, sortOrder])
}

model Media {
  id          String   @id @default(cuid())
  contentType String
  data        Bytes
  createdAt   DateTime @default(now())
}

model SiteSettings {
  id                   Int      @id @default(1)
  showCodeCentreOnHome Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

// Generic, database-backed content storage for future admin-managed copy.
// Application source files are never edited through the admin UI.
model SiteContent {
  id        Int      @id @default(autoincrement())
  page      String
  section   String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([page, section, key])
}

// Records one-time content imports so deleted items are never re-seeded.
model ContentImport {
  key       String   @id
  createdAt DateTime @default(now())
}
